<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Offers - <%= property.title %> - Fabric Escrow</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #667eea;
        }
        .nav a {
            margin-left: 20px;
            text-decoration: none;
            color: #333;
            font-weight: 500;
        }
        .nav a:hover {
            color: #667eea;
        }
        .welcome {
            margin-right: 20px;
            color: #333;
        }
        .card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }
        .property-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        .property-info h2 {
            margin-bottom: 15px;
            font-size: 28px;
        }
        .property-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .property-detail {
            background: rgba(255,255,255,0.1);
            padding: 15px;
            border-radius: 8px;
        }
        .property-detail .label {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 5px;
        }
        .property-detail .value {
            font-size: 24px;
            font-weight: bold;
        }
        .offers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }
        .offer-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 25px;
            border: 1px solid #e2e8f0;
            transition: transform 0.3s, box-shadow 0.3s;
            position: relative;
            overflow: hidden;
        }
        .offer-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px rgba(0,0,0,0.1);
        }
        .offer-status {
            position: absolute;
            top: 0;
            right: 0;
            padding: 8px 16px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            border-bottom-left-radius: 8px;
        }
        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }
        .status-accepted {
            background: #c6f6d5;
            color: #22543d;
        }
        .status-rejected {
            background: #fed7d7;
            color: #9b2c2c;
        }
        .offer-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-right: 60px;
        }
        .buyer-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .buyer-avatar {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            font-weight: bold;
        }
        .buyer-name {
            font-size: 18px;
            font-weight: 600;
            color: #2d3748;
        }
        .buyer-id {
            font-size: 14px;
            color: #718096;
        }
        .offer-amount {
            font-size: 32px;
            font-weight: bold;
            color: #667eea;
            margin: 20px 0;
            text-align: center;
        }
        .offer-details {
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
            margin-top: 20px;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            color: #4a5568;
        }
        .detail-label {
            font-weight: 500;
        }
        .detail-value {
            font-weight: 600;
        }
        .offer-actions {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }
        .btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            text-align: center;
        }
        .btn-accept {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
            color: white;
        }
        .btn-accept:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(72, 187, 120, 0.4);
        }
        .btn-reject {
            background: linear-gradient(135deg, #f56565 0%, #e53e3e 100%);
            color: white;
        }
        .btn-reject:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 101, 101, 0.4);
        }
        .btn-back {
            background: #cbd5e0;
            color: #2d3748;
        }
        .btn-back:hover {
            background: #a0aec0;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #f8fafc;
            border-radius: 12px;
        }
        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.5;
        }
        .empty-state h3 {
            font-size: 24px;
            color: #2d3748;
            margin-bottom: 10px;
        }
        .empty-state p {
            color: #718096;
            margin-bottom: 25px;
        }
        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .alert-success {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }
        .alert-error {
            background: #fed7d7;
            color: #9b2c2c;
            border: 1px solid #feb2b2;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">🏠 Fabric Escrow</div>
            <div class="nav">
                <span class="welcome">Welcome, <%= user.name %></span>
                <a href="/dashboard">Dashboard</a>
                <a href="/logout">Logout</a>
            </div>
        </div>

        <% if (locals.success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <div class="property-info">
            <h2>🏠 <%= property.title %></h2>
            <div class="property-details">
                <div class="property-detail">
                    <div class="label">Prix demandé</div>
                    <div class="value"><%= property.price %> €</div>
                </div>
                <div class="property-detail">
                    <div class="label">Localisation</div>
                    <div class="value"><%= property.location %></div>
                </div>
                <div class="property-detail">
                    <div class="label">Statut</div>
                    <div class="value"><%= property.status %></div>
                </div>
                <div class="property-detail">
                    <div class="label">Total offres</div>
                    <div class="value"><%= offers ? offers.length : 0 %></div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2 style="margin-bottom: 25px; color: #2d3748;">📋 Offres reçues</h2>

            <% if (offers && offers.length > 0) { %>
                <div class="offers-grid">
                    <% offers.forEach(offer => { %>
                        <div class="offer-card">
                            <div class="offer-status status-<%= offer.status %>">
                                <%= offer.status === 'pending' ? 'En attente' :
                                    offer.status === 'accepted' ? 'Acceptée' : 'Refusée' %>
                            </div>

                            <div class="offer-header">
                                <div class="buyer-info">
                                    <div class="buyer-avatar">
                                        <%= offer.buyerName ? offer.buyerName.charAt(0).toUpperCase() : 'A' %>
                                    </div>
                                    <div>
                                        <div class="buyer-name"><%= offer.buyerName %></div>
                                        <div class="buyer-id"><%= offer.buyerId %></div>
                                    </div>
                                </div>
                            </div>

                            <div class="offer-amount">
                                <%= offer.amount %> €
                            </div>

                            <div class="offer-details">
                                <div class="detail-row">
                                    <span class="detail-label">Date de l'offre:</span>
                                    <span class="detail-value"><%= new Date(offer.createdAt).toLocaleDateString('fr-FR') %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Type d'acheteur:</span>
                                    <span class="detail-value">Particulier</span>
                                </div>
                            </div>

                            <% if (offer.status === 'pending') { %>
                                <div class="offer-actions">
                                    <form action="/offer/<%= offer.id %>/accept" method="POST" style="flex: 1;">
                                        <button type="submit" class="btn btn-accept">✓ Accepter</button>
                                    </form>
                                    <form action="/offer/<%= offer.id %>/reject" method="POST" style="flex: 1;">
                                        <button type="submit" class="btn btn-reject">✗ Refuser</button>
                                    </form>
                                </div>
                            <% } else if (offer.status === 'accepted') { %>
                                <div style="text-align: center; padding: 15px; background: #c6f6d5; border-radius: 8px; color: #22543d; font-weight: 600;">
                                    ✅ Offre acceptée - Une session a été créée
                                </div>
                            <% } else if (offer.status === 'rejected') { %>
                                <div style="text-align: center; padding: 15px; background: #fed7d7; border-radius: 8px; color: #9b2c2c; font-weight: 600;">
                                    ❌ Offre refusée
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <h3>Aucune offre pour le moment</h3>
                    <p>Les acheteurs n'ont pas encore fait d'offre sur cette propriété.</p>
                    <a href="/dashboard" class="btn btn-back" style="display: inline-block; padding: 12px 30px;">Retour au dashboard</a>
                </div>
            <% } %>

            <div style="margin-top: 30px; text-align: center;">
                <a href="/dashboard" class="btn btn-back" style="display: inline-block; padding: 12px 30px;">← Retour au dashboard</a>
            </div>
        </div>
    </div>
</body>
</html>
